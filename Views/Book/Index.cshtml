
@model IEnumerable<NetCoreMVCLap03.Models.Book>
@{
    ViewData["Title"] = "Index";
}
<h2>Danh sách các cuốn sách</h2>
<from action="" method="POST" class="from-inline" role="form">
    <div class="form-group">
        <select name="AuthorId" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn tác giả</option>
        </select>
        <select name="GenreId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Chọn thể loại</option>
        </select>
    </div>
    <button type="submit" class="btn btn-promary">Tìm kiếm</button>
    <a asp-action="Create" class="btn btn-danger">Thêm mới</a>
    </from>
    <hr />
  <!---->
  <table class="table table-bordered">
      <thead>
          <tr>
          <th>Id</th>
          <th>Tiêu đề</th>
        <th>Tác giả</th>
        <th>Thể loại</th>
        <th>Giá</th>
        <th>Hình ảnh</th>
        <th></th>
        </tr>
      </thead>
      <tbody>
          @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.AuthorId</td>
                <td>@book.Price</td>
                <td>
                    <img src="/~images/@book.Image" alt="@book.Title" width="40"/>
                </td>
                <td>
                    <a asp-action="Edit" class="btn tbn-sm btn-primary">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
  </table>