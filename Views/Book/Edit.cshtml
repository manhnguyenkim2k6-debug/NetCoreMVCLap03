@model NetCoreMVCLap03.Models.Book
@{
    ViewData["Title"] = "Chỉnh sửa sách";
}

<h2>Chỉnh sửa sách</h2>

<form asp-action="Edit" method="post">
    <!-- Giữ lại Id của sách khi thực hiện Lưu -->
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="Title">Tên sách</label>
        <input asp-for="Title" class="form-control" placeholder="Tên sách" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="AuthorId">Tác giả</label>
        <select asp-for="AuthorId" class="form-control" asp-items="ViewBag.authors">
            <option value="">Chọn tác giả</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="GenreId">Thể loại</label>
        <select asp-for="GenreId" class="form-control" asp-items="ViewBag.genres">
            <option value="">Chọn thể loại</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">Giá sách</label>
        <input asp-for="Price" class="form-control" placeholder="Giá sách" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="TotalPage">Tổng số trang</label>
        <input asp-for="TotalPage" class="form-control" placeholder="Tổng số trang" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Image">Hình ảnh</label>
        <input type="file" asp-for="Image" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Sumary">Giới thiệu ngắn</label>
        <textarea asp-for="Sumary" class="form-control" rows="3" placeholder="Nội dung giới thiệu sách..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu lại</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>